{
  "name": "yusr-backend",
  "version": "1.0.0",
  "description": "منصة يسر التعليمية - Backend API",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "cd ../frontend && npm install && npm run build",
    "seed": "node seed.js",
    "migrate": "node migrate-pg.js",
    "dev": "node --env-file=.env --watch server.js",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1128.0",
    "@aws-sdk/s3-request-presigner": "^3.1128.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "nodemailer": "^10.0.0",
    "pg": "^8.13.0",
    "resend": "^6.28.0"
  }
}
