# ===== منصة يُسر التعليمية — متغيرات البيئة =====
# انسخ هذا الملف إلى .env وعبّئ القيم الحقيقية (لا تُرسل .env إلى Git أبداً)

# المنفذ الذي يعمل عليه الخادم
PORT=5000

# مفتاح توقيع JWT — غيّره إلى قيمة عشوائية طويلة في الإنتاج
# مثال للتوليد: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# إشعارات/مكالمات عامة (اختياري)
BASE_URL=http://localhost:5000

# CORS: افصل بالنقاط أو اتركه فارغاً للسماح للجميع أثناء التطوير
CORS_ORIGINS=

# بوابة الدفع (Mock أثناء التطوير — لا تستخدم مفاتيح حقيقية هنا)
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=

# تخزين الفيديو/الملفات (اختياري — التخزين المحلي الافتراضي)
STORAGE_URL=

# بيانات التواصل الافتراضية (قابلة للتعديل من لوحة الإدارة)
WHATSAPP_NUMBER=