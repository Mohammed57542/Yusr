# ═══════════════════════════════════════════
# منصة يسر — ملف المتغيرات البيئية
# انسخ هذا الملف إلى .env واملأ القيم
# ═══════════════════════════════════════════

# ─── الخادم ───
PORT=5000
NODE_ENV=development

# ─── الأمان ───
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173,http://localhost:5000

# ─── قاعدة البيانات (PostgreSQL — اختياري، SQLite افتراضي) ───
# DATABASE_URL=postgresql://user:password@localhost:5432/yusr

# ─── البريد الإلكتروني (SMTP) ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── مزود الدفع (MyFatoorah) ───
PAYMENT_PROVIDER=myfatoorah
MYFATOORAH_API_KEY=
MYFATOORAH_TEST_API_KEY=
MYFATOORAH_WEBHOOK_SECRET=
MYFATOORAH_BASE_URL=https://api.myfatoorah.com

# ─── التخزين السحابي ───
# local = محلي (للتطوير)
# s3    = AWS S3 / Cloudflare R2 (للإنتاج)
STORAGE_DRIVER=local

# S3 / R2 credentials
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_PUBLIC_BASE=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── روابط ───
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# ─── الذكاء الاصطناعي (اختياري) ───
# OPENAI_API_KEY=

# ─── reCAPTCHA (اختياري) ───
# RECAPTCHA_SECRET_KEY=
