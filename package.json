{
  "name": "yusr-platform",
  "version": "1.0.0",
  "description": "منصة يُسر التعليمية — دروس واختبارات وفق المنهج العُماني",
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env backend/server.js",
    "seed": "node --env-file=.env backend/seed.js",
    "dev": "node --env-file=.env --watch backend/server.js",
    "test": "node --test backend/tests/*.test.mjs",
    "build": "cd frontend && npm install && npm run build",
    "postinstall": "cd backend && npm install"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2"
  }
}
