# متغيرات البيئة — انسخ هذا الملف إلى .env وعدّل القيم

# === التشغيل ===
NODE_ENV=production
PORT=5000
JWT_SECRET=CHANGE_ME_to_a_long_random_string_32_chars
FRONTEND_URL=https://your-domain.com

# === قاعدة البيانات ===
# اتركه فارغاً لاستخدام SQLite الافتراضي (backend/data/yusr.db)
# DB_PATH=

# === بوابة الدفع (MyFatoorah) ===
# MYFATOORAH_TEST_MODE=true   ← للتطوير (يستخدم test token)
# MYFATOORAH_TEST_MODE=false  ← للإنتاج (يحتاج API key حقيقي)
PAYMENT_PROVIDER=myfatoorah
MYFATOORAH_TEST_MODE=true
MYFATOORAH_API_KEY=
MYFATOORAH_COUNTRY=OMN
MYFATOORAH_WEBHOOK_SECRET=

# === CORS ===
# اتركه فارغاً للسماح بـ localhost فقط
# CORS_ORIGINS=https://your-domain.com

# === reCAPTCHA (اختياري للإنتاج) ===
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SITE_KEY=
